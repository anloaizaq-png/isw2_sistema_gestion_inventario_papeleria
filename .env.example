# =====================================================================
# Variables de Entorno Globales - Cotton Cloud Paper
# Copia este archivo a .env antes de levantar los servicios
# =====================================================================

# Configuración del entorno
NODE_ENV=production
PROXY_TIMEOUT_MS=10000

# ---------------------------------------------------------------------
# SEGURIDAD Y JWT (API Gateway)
# ---------------------------------------------------------------------
JWT_SECRET=cotton_cloud_super_secret_jwt_key_2024
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=cotton-cloud-gateway
JWT_AUDIENCE=cotton-cloud-services

# ---------------------------------------------------------------------
# USUARIO ADMINISTRADOR INICIAL (Seed idempotente)
# ---------------------------------------------------------------------
ADMIN_NAME=Administrador Inicial
ADMIN_EMAIL=admin@cottoncloud.com
ADMIN_PASSWORD=Admin1234*

# ---------------------------------------------------------------------
# 1. BASE DE DATOS: IDENTIDAD (gateway-service)
# ---------------------------------------------------------------------
DB_IDENTIDAD_ROOT_PASSWORD=root_pass_identidad
DB_IDENTIDAD_NAME=identidad
DB_IDENTIDAD_USER=identidad_user
DB_IDENTIDAD_PASSWORD=identidad_pass

# ---------------------------------------------------------------------
# 2. BASE DE DATOS: PRODUCTOS (productos-service)
# ---------------------------------------------------------------------
DB_PRODUCTOS_ROOT_PASSWORD=root_pass_productos
DB_PRODUCTOS_NAME=productos
DB_PRODUCTOS_USER=productos_user
DB_PRODUCTOS_PASSWORD=productos_pass

# ---------------------------------------------------------------------
# 3. BASE DE DATOS: INVENTARIO (inventario-service)
# ---------------------------------------------------------------------
DB_INVENTARIO_ROOT_PASSWORD=root_pass_inventario
DB_INVENTARIO_NAME=inventario
DB_INVENTARIO_USER=inventario_user
DB_INVENTARIO_PASSWORD=inventario_pass

# ---------------------------------------------------------------------
# 4. BASE DE DATOS: VENTAS (ventas-service)
# ---------------------------------------------------------------------
DB_VENTAS_ROOT_PASSWORD=root_pass_ventas
DB_VENTAS_NAME=ventas
DB_VENTAS_USER=ventas_user
DB_VENTAS_PASSWORD=ventas_pass

# ---------------------------------------------------------------------
# 5. BASE DE DATOS: COMPRAS (compras-service)
# ---------------------------------------------------------------------
DB_COMPRAS_ROOT_PASSWORD=root_pass_compras
DB_COMPRAS_NAME=compras
DB_COMPRAS_USER=compras_user
DB_COMPRAS_PASSWORD=compras_pass

# ---------------------------------------------------------------------
# 6. BASE DE DATOS: ANALÍTICA (analitica-service)
# ---------------------------------------------------------------------
DB_ANALITICA_ROOT_PASSWORD=root_pass_analitica
DB_ANALITICA_NAME=analitica
DB_ANALITICA_USER=analitica_user
DB_ANALITICA_PASSWORD=analitica_pass

# ---------------------------------------------------------------------
# COMUNICACIÓN INTERNA ENTRE MICROSERVICIOS (Red interna cotton-net)
# ---------------------------------------------------------------------
PRODUCTOS_URL=http://productos-service:8080
INVENTARIO_URL=http://inventario-service:8080
VENTAS_URL=http://ventas-service:8080
COMPRAS_URL=http://compras-service:8080
ANALITICA_URL=http://analitica-service:8080
ALERTAS_URL=http://analitica-service:8080
APP_PORT=8080
PORT=8080
